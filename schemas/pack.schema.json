{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/shrug-labs/aipack/main/schemas/pack.schema.json",
  "title": "aipack pack manifest",
  "description": "Schema for aipack pack.json manifests.",
  "type": "object",
  "required": ["schema_version", "name", "root"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "enum": [1, 2]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "native_plugin": {
      "$ref": "#/definitions/nativePlugin"
    },
    "rules": {
      "$ref": "#/definitions/nullableContentSlashedIDs"
    },
    "agents": {
      "$ref": "#/definitions/nullableStringList"
    },
    "workflows": {
      "$ref": "#/definitions/nullableStringList"
    },
    "skills": {
      "$ref": "#/definitions/nullableStringList"
    },
    "prompts": {
      "$ref": "#/definitions/nullableSlashedIDs"
    },
    "mcp": true,
    "configs": {
      "$ref": "#/definitions/nullableConfigs"
    },
    "hooks": {
      "$ref": "#/definitions/nullableStringList"
    },
    "profiles": {
      "$ref": "#/definitions/nullableYAMLRefs"
    },
    "registries": {
      "$ref": "#/definitions/nullableYAMLRefs"
    },
    "extras": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/extraPath"
          }
        }
      ]
    },
    "include": {
      "description": "Legacy schema_version: 1 extra file list; use extras in current manifests.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/relativePath"
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "mcp": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/definitions/legacyMCP"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        },
        "required": ["schema_version"],
        "not": { "required": ["native_plugin"] }
      },
      "then": {
        "properties": {
          "mcp": {
            "$ref": "#/definitions/nullableSlashedIDs"
          }
        }
      }
    },
    {
      "if": { "required": ["native_plugin"] },
      "then": {
        "properties": {
          "name": {
            "allOf": [
              { "$ref": "#/definitions/nativeName" },
              { "not": { "pattern": "__aipack__|\\.\\." } }
            ]
          },
          "mcp": { "$ref": "#/definitions/nullableStringList" }
        }
      },
      "else": {
        "properties": {
          "name": { "$ref": "#/definitions/packName" },
          "version": { "type": "string", "minLength": 1 },
          "agents": { "$ref": "#/definitions/nullableContentLeafIDs" },
          "workflows": { "$ref": "#/definitions/nullableContentLeafIDs" },
          "skills": { "$ref": "#/definitions/nullableContentLeafIDs" },
          "hooks": { "$ref": "#/definitions/nullableContentLeafIDs" }
        }
      }
    }
  ],
  "definitions": {
    "nativeName": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "nativeComponentMap": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "oneOf": [{ "$ref": "#/definitions/relativePath" }, { "const": "" }]
        }
      }
    },
    "nativePlugin": {
      "description": "Generated descriptor for a complete native package retained under upstream/. Native executable trust remains with its host.",
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "harness", "name", "marketplace", "manifest", "converter_version", "components"],
      "properties": {
        "format": { "enum": ["codex-legacy", "claude", "agent-plugins"] },
        "harness": { "enum": ["codex", "claudecode"] },
        "name": { "$ref": "#/definitions/nativeName" },
        "marketplace": { "$ref": "#/definitions/nativeName" },
        "manifest": { "enum": [".codex-plugin/plugin.json", ".claude-plugin/plugin.json", "plugin.json", ""] },
        "converter_version": { "type": "integer", "minimum": 1 },
        "copied_source": { "type": "boolean" },
        "cache_version": { "type": "string", "pattern": "^(unknown|[0-9a-f]{12}(-[0-9a-f]{8})?)$" },
        "root_directory_name": { "type": "string", "not": { "enum": [".", ".."] }, "pattern": "^[^/\\\\\u0000]*$" },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skills": { "$ref": "#/definitions/nativeComponentMap" },
            "agents": { "$ref": "#/definitions/nativeComponentMap" },
            "workflows": { "$ref": "#/definitions/nativeComponentMap" },
            "hooks": { "$ref": "#/definitions/nativeComponentMap" },
            "mcp": { "$ref": "#/definitions/nativeComponentMap" }
          }
        },
        "hook_events": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "settings_files": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/relativePath" }
        },
        "marketplace_entry": { "type": "object" },
        "catalog_command_order": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "marketplace_metadata": { "type": "object" }
      }
    },
    "packName": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        {
          "not": {
            "pattern": "__aipack__"
          }
        }
      ]
    },
    "leafID": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "contentLeafID": {
      "allOf": [
        {
          "$ref": "#/definitions/leafID"
        },
        {
          "not": {
            "pattern": "__aipack__"
          }
        }
      ]
    },
    "slashedID": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$"
    },
    "contentSlashedID": {
      "allOf": [
        {
          "$ref": "#/definitions/slashedID"
        },
        {
          "not": {
            "pattern": "__"
          }
        }
      ]
    },
    "yamlRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*(\\.yaml)?$"
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nullableStringList": {
      "type": ["array", "null"],
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "leafIDs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/leafID"
      }
    },
    "contentLeafIDs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/contentLeafID"
      }
    },
    "slashedIDs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/slashedID"
      }
    },
    "contentSlashedIDs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/contentSlashedID"
      }
    },
    "yamlRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/yamlRef"
      }
    },
    "nullableLeafIDs": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/leafIDs"
        }
      ]
    },
    "nullableContentLeafIDs": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/contentLeafIDs"
        }
      ]
    },
    "nullableSlashedIDs": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/slashedIDs"
        }
      ]
    },
    "nullableContentSlashedIDs": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/contentSlashedIDs"
        }
      ]
    },
    "nullableYAMLRefs": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/yamlRefs"
        }
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "type": "string",
            "pattern": "^/"
          }
        },
        {
          "not": {
            "type": "string",
            "pattern": "^[A-Za-z]:"
          }
        },
        {
          "not": {
            "type": "string",
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        }
      ]
    },
    "extraPath": {
      "allOf": [
        {
          "$ref": "#/definitions/relativePath"
        },
        {
          "not": {
            "type": "string",
            "pattern": "^(rules|agents|workflows|skills|prompts|plugins|mcp|configs|hooks|profiles|registries)(/|$)"
          }
        }
      ]
    },
    "configFileList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/relativePath"
      }
    },
    "harnessFileMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/configFileList"
      }
    },
    "configs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "harness_settings": {
          "$ref": "#/definitions/harnessFileMap"
        },
        "harness_plugins": {
          "$ref": "#/definitions/harnessFileMap"
        }
      }
    },
    "nullableConfigs": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/configs"
        }
      ]
    },
    "nullableHarnessFileMap": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/harnessFileMap"
        }
      ]
    },
    "legacyMCPServer": {
      "type": "object",
      "properties": {
        "allowed_tools": {
          "$ref": "#/definitions/stringList"
        },
        "always_allowed_tools": {
          "$ref": "#/definitions/stringList"
        },
        "disabled_tools": {
          "$ref": "#/definitions/stringList"
        }
      },
      "additionalProperties": true
    },
    "legacyMCP": {
      "type": "object",
      "required": ["servers"],
      "additionalProperties": false,
      "properties": {
        "servers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/legacyMCPServer"
          }
        },
        "default_allowed_tools": {
          "$ref": "#/definitions/stringList"
        },
        "default_always_allowed_tools": {
          "$ref": "#/definitions/stringList"
        }
      }
    }
  }
}
